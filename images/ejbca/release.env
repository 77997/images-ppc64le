# The one place that names what the ejbca track builds; the image's tag is <EJBCA_VERSION>-<REVISION>.
# REVISION rises by one for each change to the image at the same EJBCA release, and returns to 1 for a new release.
# Every download the Dockerfile makes is checked against the SHA-256 written here, so a moved tag or a replaced file
# stops the build.
EJBCA_VERSION=9.6.3
REVISION=3
EJBCA_SOURCE_URL=https://github.com/Keyfactor/ejbca-ce/archive/refs/tags/r9.6.3.tar.gz
EJBCA_SOURCE_SHA256=2720c7ef8466b2d2181d27daf3bfac1ba15e1a0ed2494856a0b3720b35932d4c
# The full WildFly distribution rather than a Galleon build, because EJBCA's CLI is built against its
# bin/client/jboss-client.jar. Its SHA-256 was taken from a download whose SHA-1 matches the one WildFly publishes.
WILDFLY_VERSION=39.0.1.Final
WILDFLY_URL=https://github.com/wildfly/wildfly/releases/download/39.0.1.Final/wildfly-39.0.1.Final.tar.gz
WILDFLY_SHA256=30ce0874378d1100289d4820fce1f7646ab1278f8c30c7ae9bb84c16cbd510cb
# Maven Central publishes no SHA-256 for this jar; this one was taken from a download whose SHA-1 matches the one
# Maven Central publishes.
POSTGRESQL_JDBC_VERSION=42.7.10
POSTGRESQL_JDBC_URL=https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.10/postgresql-42.7.10.jar
POSTGRESQL_JDBC_SHA256=cab1cd67cfa25c25de4348e532298028288a877ba01c77d1619fe45416193387
