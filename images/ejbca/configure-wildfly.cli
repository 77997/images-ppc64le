# Configures WildFly for EJBCA once, at image build, following Keyfactor's WildFly 39 page for EJBCA 9.6 with the
# listener layout of the EJBCA this image replaces. Nothing secret is written: the database address and credentials
# and the TLS store passwords are expressions that WildFly resolves from the environment at each start.
# Run by jboss-cli.sh --file, which stops at the first command that fails.

# Admin-only, so the data source and the listeners stay stopped while the batch writes the model. Elytron's key
# stores start even so; the Dockerfile gives this step throwaway values for them.
embed-server --server-config=standalone.xml --std-out=echo --admin-only=true

batch

# The database, through the driver module org.postgresql. Validation, pool and statement cache as Keyfactor gives
# them; the address, user and password come from the environment.
/subsystem=datasources/jdbc-driver=postgresql:add(driver-name=postgresql, driver-module-name=org.postgresql, driver-class-name=org.postgresql.Driver)
/subsystem=datasources/data-source=ejbcads:add(jndi-name="java:/EjbcaDS", driver-name=postgresql, connection-url="${env.EJBCA_DATABASE_URL}", user-name="${env.EJBCA_DATABASE_USER}", credential-reference={clear-text="${env.EJBCA_DATABASE_PASSWORD}"}, use-ccm=true, validate-on-match=true, background-validation=false, prepared-statements-cache-size=50, share-prepared-statements=true, min-pool-size=5, max-pool-size=150, pool-prefill=true, transaction-isolation=TRANSACTION_READ_COMMITTED, check-valid-connection-sql="select 1;")

# The example datasource and the default bindings that point at it are unused, as Keyfactor removes them.
/subsystem=ee/service=default-bindings:remove()
/subsystem=datasources/data-source=ExampleDS:remove()
/subsystem=datasources/jdbc-driver=h2:remove()

# Remoting for the EJBCA CLI on 4447, on the loopback management interface, as Keyfactor configures it; the CLI's
# client connects to localhost:4447.
/subsystem=remoting/http-connector=http-remoting-connector:write-attribute(name=connector-ref, value=remoting)
/socket-binding-group=standard-sockets/socket-binding=remoting:add(port=4447, interface=management)
/subsystem=undertow/server=default-server/http-listener=remoting:add(socket-binding=remoting, enable-http2=true)

# WildFly 38 and later expect a distributed web session cache for EJBCA's session replication setting; Keyfactor
# removes the dormant file store so a standalone server deploys.
/subsystem=infinispan/cache-container=web/local-cache=passivation/store=file:remove()

# Logging. Keyfactor's application loggers, and the console alone: the file handler goes, so nothing written inside
# the container grows, and the host's container logs keep the output.
/subsystem=logging/logger=org.ejbca:add(level=INFO)
/subsystem=logging/logger=org.cesecore:add(level=INFO)
/subsystem=logging/logger=com.keyfactor:add(level=INFO)
/subsystem=logging/root-logger=ROOT:remove-handler(name=FILE)
/subsystem=logging/periodic-rotating-file-handler=FILE:remove()
/core-service=management/access=audit:remove()
/subsystem=elytron/file-audit-log=local-audit:remove()

# WildFly's own HTTP and HTTPS listeners make way for EJBCA's three.
/subsystem=undertow/server=default-server/http-listener=default:remove()
/socket-binding-group=standard-sockets/socket-binding=http:remove()
/subsystem=undertow/server=default-server/https-listener=https:remove()
/socket-binding-group=standard-sockets/socket-binding=https:remove()

# The three listeners answer on every address: "::" is the wildcard of a dual-stack socket, which serves IPv4 too.
# Management (9990), remoting (4447) and the transaction manager's own sockets stay on loopback.
/interface=http:add(inet-address="::")
/interface=httpspub:add(inet-address="::")
/interface=httpspriv:add(inet-address="::")
/socket-binding-group=standard-sockets/socket-binding=http:add(port=8080, interface=http)
/socket-binding-group=standard-sockets/socket-binding=httpspub:add(port=8442, interface=httpspub)
/socket-binding-group=standard-sockets/socket-binding=httpspriv:add(port=8443, interface=httpspriv)

# The server key store and the trust store of client CAs, mounted read only from the host. required=true makes
# WildFly refuse to start without them rather than serve an empty store; their passwords come from the environment.
/subsystem=elytron/key-store=httpsKS:add(path="/etc/ejbca/tls/keystore.p12", type=PKCS12, required=true, credential-reference={clear-text="${env.EJBCA_KEYSTORE_PASSWORD}"})
/subsystem=elytron/key-store=httpsTS:add(path="/etc/ejbca/tls/truststore.p12", type=PKCS12, required=true, credential-reference={clear-text="${env.EJBCA_TRUSTSTORE_PASSWORD}"})
/subsystem=elytron/key-manager=httpsKM:add(key-store=httpsKS, algorithm="SunX509", credential-reference={clear-text="${env.EJBCA_KEYSTORE_PASSWORD}"})
/subsystem=elytron/trust-manager=httpsTM:add(key-store=httpsTS)

# 8442 proves the server alone; 8443 also requires a client certificate issued by a CA of the trust store, which is how
# administrators sign in. TLS 1.3 and 1.2 with Keyfactor's cipher suites.
/subsystem=elytron/server-ssl-context=httpspub:add(key-manager=httpsKM, protocols=["TLSv1.3","TLSv1.2"], use-cipher-suites-order=false, cipher-suite-filter="TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384,TLS_DHE_RSA_WITH_AES_256_CBC_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_RSA_WITH_AES_256_CBC_SHA256,TLS_RSA_WITH_AES_256_CBC_SHA,TLS_DHE_RSA_WITH_AES_256_GCM_SHA384,TLS_DHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256", cipher-suite-names="TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256")
/subsystem=elytron/server-ssl-context=httpspriv:add(key-manager=httpsKM, protocols=["TLSv1.3","TLSv1.2"], use-cipher-suites-order=false, cipher-suite-filter="TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384,TLS_DHE_RSA_WITH_AES_256_CBC_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_RSA_WITH_AES_256_CBC_SHA256,TLS_RSA_WITH_AES_256_CBC_SHA,TLS_DHE_RSA_WITH_AES_256_GCM_SHA384,TLS_DHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256", cipher-suite-names="TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256", trust-manager=httpsTM, need-client-auth=true)

# Plain HTTP serves the public protocols and sends the pages EJBCA marks confidential, the administration pages among
# them, to 8443.
/subsystem=undertow/server=default-server/http-listener=http:add(socket-binding=http, redirect-socket=httpspriv)
/subsystem=undertow/server=default-server/https-listener=httpspub:add(socket-binding=httpspub, ssl-context=httpspub, max-parameters=2048)
/subsystem=undertow/server=default-server/https-listener=httpspriv:add(socket-binding=httpspriv, ssl-context=httpspriv, max-parameters=2048)

# Request handling EJBCA expects of the servlet container, as Keyfactor sets it.
/system-property=org.apache.catalina.connector.URI_ENCODING:add(value="UTF-8")
/system-property=org.apache.catalina.connector.USE_BODY_ENCODING_FOR_QUERY_STRING:add(value=true)
/system-property=org.apache.tomcat.util.buf.UDecoder.ALLOW_ENCODED_SLASH:add(value=true)
/system-property=org.apache.tomcat.util.http.Parameters.MAX_COUNT:add(value=2048)
/system-property=org.apache.catalina.connector.CoyoteAdapter.ALLOW_BACKSLASH:add(value=true)
/subsystem=webservices:write-attribute(name=wsdl-host, value=jbossws.undefined.host)
/subsystem=webservices:write-attribute(name=modify-wsdl-address, value=true)

# WildFly's welcome page goes, and a GET outside EJBCA's own paths is sent to EJBCA's RA pages, with Keyfactor's
# predicate. EJBCA 9.6 serves nothing at /ejbca/ itself, so a GET of /ejbca or /ejbca/ is sent there too.
/subsystem=undertow/server=default-server/host=default-host/location="\/":remove()
/subsystem=undertow/configuration=handler/file=welcome-content:remove()
/subsystem=undertow/configuration=filter/rewrite=redirect-to-app:add(redirect=true, target="/ejbca/ra/")
/subsystem=undertow/server=default-server/host=default-host/filter-ref=redirect-to-app:add(priority=1, predicate="method(GET) and (path(/ejbca) or path(/ejbca/) or not path-prefix(/ejbca,/crls,/certificates,/.well-known)) and not equals({\%{LOCAL_PORT}, 4447})")

# The ear in the image is the only deployment and never changes while the server runs, so the directory is scanned
# once at start. The first start against a database from an earlier EJBCA upgrades its schema inside the deployment,
# so the deployment gets Keyfactor's longer timeout.
/subsystem=deployment-scanner/scanner=default:write-attribute(name=scan-interval, value=0)
/subsystem=deployment-scanner/scanner=default:write-attribute(name=deployment-timeout, value=300)

run-batch

stop-embedded-server
