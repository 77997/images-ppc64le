# The one place that names what the gerrit track builds; the image's tag is <GERRIT_VERSION>-<REVISION>.
# REVISION rises by one for each change to the image at the same Gerrit release, and returns to 1 for a new release.
GERRIT_VERSION=3.15.0
REVISION=2
# The SAML plugin is built inside Gerrit's tree, so both trees are pinned by commit for this release; a new Gerrit
# release needs new pins here, and the build refuses a tag that has moved. The plugin has no branch for Gerrit 3.15, so
# its pin is a commit of its master.
GERRIT_COMMIT=72e92fcc1d4c2ce32b71019816afdde4c66aa746
SAML_COMMIT=b8971ae1c979757557751dd312257d3a995155d1
BAZELISK_VERSION=1.30.0
BAZELISK_SHA256=a248ae2b2b62b5baebb748f6fba7203bff1a27e5d01b55399a8406744cb539e8
