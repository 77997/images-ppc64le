# The one place that names what the keycloak track builds; the image's tag is <KEYCLOAK_VERSION>-<REVISION>.
# REVISION rises by one for each change to the image at the same Keycloak release, and returns to 1 for a new release.
# The download the Dockerfile makes is checked against the SHA-256 written here, so a moved tag or a replaced file
# stops the build. The SHA-256 is the digest GitHub publishes for the release asset.
KEYCLOAK_VERSION=26.8.2
REVISION=1
KEYCLOAK_URL=https://github.com/keycloak/keycloak/releases/download/26.8.2/keycloak-26.8.2.tar.gz
KEYCLOAK_SHA256=dd124787283918bc597628887168333465ee2a811a389e0003569e52be7e487f
